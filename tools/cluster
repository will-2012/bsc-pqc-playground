#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

candidates=(python3 python3.14 python3.13 python3.12 python3.11)
if [[ -n "${BSC_PQC_PYTHON:-}" ]]; then
    candidates=("$BSC_PQC_PYTHON")
fi
for python in "${candidates[@]}"; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import sys, tarfile, tomllib; assert sys.version_info >= (3, 11); assert hasattr(tarfile, "data_filter")' >/dev/null 2>&1; then
        exec "$python" "$root/one-box/remote/cluster.py" "$@"
    fi
done
printf '%s\n' '需要 Python 3.11+（包含 tomllib 和 tarfile.data_filter）。' '请安装兼容版本，或设置 BSC_PQC_PYTHON=/path/to/python3.11；无需替换系统 Python。' >&2
exit 1
